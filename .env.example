# FlowAI Studio Docker Compose configuration
# Copy this file to .env and fill every required secret before deployment.

# Use a URL-safe value because Compose interpolates this password into DATABASE_URL.
# Example: openssl rand -hex 24
POSTGRES_PASSWORD=

# JWT signing secret. Example: openssl rand -hex 32
JWT_SECRET=

# 32-byte AES key encoded as base64. Example: openssl rand -base64 32
# Keep this key with database backups; losing it makes stored model keys unreadable.
MODEL_CREDENTIAL_ENCRYPTION_KEY=

# Browser-visible origin, without a trailing slash.
FRONTEND_URL=http://localhost:8080

# Exact private model-service origins users may configure, comma-separated.
MODEL_PRIVATE_BASE_URL_ALLOWLIST=http://ollama:11434
