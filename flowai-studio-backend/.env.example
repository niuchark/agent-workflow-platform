# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration — PostgreSQL + pgvector
# 格式: postgresql://用户名:密码@主机:端口/数据库名?schema=public
# 需要 PostgreSQL 安装 pgvector 扩展: https://github.com/pgvector/pgvector
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flowai_studio?schema=public"

# JWT Configuration
JWT_SECRET=your-secret-key-change-me
JWT_EXPIRES_IN=7d

# 旧版服务器模型配置（不再用于用户业务调用，可留空）
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 通义千问向量模型配置
QWEN_EMBEDDING_API_KEY=
QWEN_EMBEDDING_MODEL=text-embedding-v3
QWEN_EMBEDDING_DIMENSION=1024

# 用户模型凭证（生产环境必须配置，生成命令: openssl rand -base64 32）
MODEL_CREDENTIAL_ENCRYPTION_KEY=
# 允许用户连接的私网模型服务 Origin，多个用逗号分隔
MODEL_PRIVATE_BASE_URL_ALLOWLIST=http://ollama:11434

# Embedding Provider 配置 (qwen | openai | ollama)
EMBEDDING_PROVIDER=qwen

# OpenAI Embedding 配置
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSION=1536

# Ollama 本地模型配置
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_DIMENSION=768

# Vector Store 配置 (pgvector | qdrant | milvus)
VECTOR_STORE=pgvector

# Qdrant 配置
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=your-qdrant-api-key

# Milvus 配置
MILVUS_URL=http://localhost:19530
# MILVUS_TOKEN=your-milvus-token

# Redis Configuration — 缓存、会话管理、限流
REDIS_URL=redis://localhost:6379

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# 文件上传配置
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760
